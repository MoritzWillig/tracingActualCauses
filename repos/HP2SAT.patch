+package de.tum.in.i4.hp2sat.util;
+
+import org.logicng.formulas.Formula;
+import org.logicng.formulas.FormulaFactory;
+import java.util.Collection;
+
+/**
+ * Python-friendly wrappers for FormulaFactory methods whose Java names
+ * are reserved keywords in Python (and, or, not).
+ */
+public class FormulaHelper {
+    public static Formula fAnd(FormulaFactory f, Collection<? extends Formula> operands) {
+        return f.and(operands);
+    }
+
+    public static Formula fOr(FormulaFactory f, Collection<? extends Formula> operands) {
+        return f.or(operands);
+    }
+
+    public static Formula fNot(FormulaFactory f, Formula operand) {
+        return f.not(operand);
+    }
+}
